{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-samragi-datamigration"
		},
		"ls_adls_retail_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stretaildatalake.dfs.core.windows.net/"
		},
		"ls_azure_sql_retail_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-retail-mig-prd.database.windows.net"
		},
		"ls_azure_sql_retail_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "RetailSalesDB"
		},
		"ls_azure_sql_retail_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "retailDBadmin"
		},
		"ls_keyvault_retail_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-retail-datamig.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-samragi-datamigration_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_keyvault_retail_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_retail_properties_typeProperties_baseUrl')]"
					},
					"ls_adls_retail_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_retail_properties_typeProperties_url')]"
					},
					"ls_azure_sql_retail_properties_typeProperties_server": {
						"value": "[parameters('ls_azure_sql_retail_properties_typeProperties_server')]"
					},
					"ls_azure_sql_retail_properties_typeProperties_database": {
						"value": "[parameters('ls_azure_sql_retail_properties_typeProperties_database')]"
					},
					"ls_azure_sql_retail_properties_typeProperties_userName": {
						"value": "[parameters('ls_azure_sql_retail_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}